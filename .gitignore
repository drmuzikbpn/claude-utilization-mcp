DerivedData/
build/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.ipa
*.dSYM.zip
*.dSYM

# Never commit TypeScript build info (house rule) or local secrets
*.tsbuildinfo
.env
.env.*
!.env.tmpl
*.p8
*.p12
*.mobileprovision

.DS_Store
