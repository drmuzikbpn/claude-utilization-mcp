{
  "name": "@drmuzikbpn/claude-usage",
  "version": "0.1.0",
  "description": "Local daemon + hook + MCP server that tells Claude Code sessions how close the account is to its rate limits, and aggregates local token spend. Not affiliated with Anthropic.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "claude-usage": "bin/claude-usage"
  },
  "files": [
    "bin",
    "dist",
    "vendor",
    "README.md",
    "LICENSE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "lefthook": "^2.2.1",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
